# Copy to .env beside README.md and paste your key after = in that local file.
# If synthway/.env already exists, update it instead: the generator and GUI read it first.
# Never put real keys in this template or include .env in a shared archive.

# Required when using OpenRouter models for generation or judging.
OPENROUTER_API_KEY=

# Optional for direct Gemini access in the CLI; not needed for the three GUI models.
GEMINI_API_KEY=
